        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "description": "工具名,不得为空且不得重复。",
          "items": {
            "$ref": "#/$defs/toolName"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "names"
      ],
      "additionalProperties": false,
      "description": "读取网页能力。"
    },
    "capability": {
      "oneOf": [
        {
          "$ref": "#/$defs/capabilityTextGenerate"
