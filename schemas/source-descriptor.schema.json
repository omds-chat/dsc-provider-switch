        },
        "contentType": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$",
          "description": "内容块类型取值,原样写入 content,例如 document。"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "文档传入方式,至少一项;file-id 依赖 endpoints.files。",
          "items": {
            "type": "string",
            "enum": [
              "base64",
              "url",
              "file-id"
            ]
          }
        }
      },
      "required": [
        "id",
        "contentType",
        "inputs"
      ],
      "additionalProperties": false,
      "description": "文档阅读能力。未声明本能力即视为不能读文档。"
    },
    "capabilityToolWebSearch": {
      "type": "object",
      "properties": {
