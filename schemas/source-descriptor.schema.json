          "items": {
            "$ref": "#/$defs/toolName"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "names"
      ],
      "additionalProperties": false,
      "description": "联网搜索能力。工具名各方言不同,不得跨方言套用。"
    },
    "capabilityToolReadUrl": {
