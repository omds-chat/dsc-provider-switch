          ],
          "description": "server-tool 指由服务端执行;request-tools 指在请求的 tools 字段里声明、由宿主或客户端执行。"
        },
        "requestField": {
          "$ref": "#/$defs/wireName",
          "description": "承载工具声明的请求字段名,可选,例如 tools。"
