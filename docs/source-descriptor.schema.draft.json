{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omds-chat.github.io/dsc-provider-switch/schemas/source-descriptor.schema.json",
  "title": "dsc-source-descriptor",
  "description": "来源描述文件:单个模型来源的端点、鉴权与能力声明。字段与判定口径以 specs/source-descriptor-spec.md 为准;本 Schema 只表达结构规则,跨字段规则见顶层 $comment。读取方不加载本 Schema,schemaVersion 不是 1 时按不可读处理。",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "结构版本,当前固定为 1;其它取值按不可读处理,不做静默降级。新增字段视为结构变更,须同步递增本字段与 specs 文档。"
    },
    "id": {
      "$ref": "#/$defs/sourceId",
      "description": "来源唯一标识,全局唯一且发布后不再改动;读取方以它作为持久化配置的键,改名须另附旧 id 映射表迁移。"
    },
    "name": {
      "$ref": "#/$defs/i18nName"
    },
    "format": {
      "$ref": "#/$defs/dialect",
      "description": "该来源的线上协议方言,决定请求体字段名、响应帧与错误体形态;端点若属另一方言家族,须在能力声明或 specs 中单独说明,不得在本字段上二选一。"
    },
    "endpoints": {
      "$ref": "#/$defs/endpoints"
    },
    "credential": {
      "$ref": "#/$defs/credential"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "该来源支持的能力及其在该来源下的参数映射,不得为空;同一 id 至多一条(按属性去重由校验脚本承担,本字段的 uniqueItems 只拦逐字重复)。未知 id 由读取方按不支持处理。",
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "format",
    "endpoints",
    "credential",
    "capabilities"
  ],
  "additionalProperties": false,
  "$comment": "跨字段规则,JSON Schema 表达不了,只由校验脚本保证:(1) capabilities 内同一 id 至多一条;(2) text:generate 的 stream 取值须与 format 的帧方言一致(none 除外);(3) 任一能力的 input 为 file-id 时 endpoints.files 必须存在;(4) 未声明 vision:image 或 document:read 时 endpoints.files 冗余但不报错。(5) base 末尾不带斜杠、path 以斜杠开头,二者直接拼接即为完整地址,不使用 URL 相对解析。",
  "examples": [
    {
      "schemaVersion": 1,
      "id": "deepseek",
      "name": {
        "zh-CN": "DeepSeek 官方",
        "en-US": "DeepSeek official"
      },
      "format": "anthropic-compatible",
      "endpoints": {
        "base": "https://api.deepseek.com",
        "chat": {
          "path": "/anthropic/v1/messages"
        },
        "models": {
          "path": "/models"
        },
        "files": {
          "path": "/anthropic/v1/files",
          "headers": [
            {
              "name": "anthropic-beta",
              "value": "files-api-2025-04-14"
            }
          ]
        }
      },
      "credential": {
        "kind": "api-key",
        "headers": [
          {
            "name": "x-api-key"
          }
        ]
      },
      "capabilities": [
        {
          "id": "text:generate",
          "stream": "sse-anthropic",
          "params": {
            "systemPrompt": "system",
            "maxTokens": "max_tokens",
            "temperature": "temperature",
            "topP": "top_p",
            "stop": "stop_sequences"
          }
        },
        {
          "id": "reasoning:think",
          "field": "thinking",
          "onValue": "enabled",
          "offValue": "disabled",
          "budgetField": "budget_tokens"
        },
        {
          "id": "vision:image",
          "input": "file-id",
          "mediaTypeField": "media_type"
        },
        {
          "id": "document:read",
          "input": "file-id"
        },
        {
          "id": "tool:web-search",
          "kind": "server-tool",
          "names": [
            "deepseek_web_search"
          ]
        },
        {
          "id": "tool:read-url",
          "kind": "server-tool",
          "names": [
            "deepseek_read_url"
          ]
        }
      ]
    },
    {
      "schemaVersion": 1,
      "id": "example-openai-gateway",
      "name": {
        "zh-CN": "示例网关",
        "en-US": "Example gateway"
      },
      "format": "openai-compatible",
      "endpoints": {
        "base": "https://api.example.com/v1",
        "chat": {
          "path": "/chat/completions"
        },
        "models": {
          "path": "/models"
        }
      },
      "credential": {
        "kind": "api-key",
        "headers": [
          {
            "name": "authorization",
            "prefix": "Bearer "
          }
        ]
      },
      "capabilities": [
        {
          "id": "text:generate",
          "stream": "sse-openai",
          "params": {
            "maxTokens": "max_tokens",
            "temperature": "temperature",
            "topP": "top_p",
            "stop": "stop"
          }
        }
      ]
    }
  ],
  "$defs": {
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "小写字母开头,只允许小写字母、数字与连字符,长度 3 到 64;与插件 id、资产包 id 同一形态。若该 id 需要同时作为合集目录名,本正则的取值是合集 id 正则的子集,不会冲突。",
      "examples": [
        "deepseek",
        "example-openai-gateway"
      ]
    },
    "i18nName": {
      "type": "object",
      "properties": {
        "zh-CN": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S",
          "description": "中文展示名,去掉首尾空白后不得为空"
        },
        "en-US": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S",
          "description": "英文展示名,去掉首尾空白后不得为空"
        }
      },
      "anyOf": [
        {
          "required": [
            "zh-CN"
          ]
        },
        {
          "required": [
            "en-US"
          ]
        }
      ],
      "additionalProperties": false,
      "description": "双语文案,至少给出一侧;与插件运行时 meta.json 的 description 同一形态。缺失的一侧由读取方用另一侧补齐。"
    },
    "dialect": {
      "type": "string",
      "enum": [
        "deepseek-compatible",
        "openai-compatible",
        "anthropic-compatible"
      ],
      "description": "线上协议方言:anthropic-compatible 指 /v1/messages 形态(message_start/content_block_delta/message_stop 帧);openai-compatible 指 /v1/chat/completions 形态;deepseek-compatible 指 openai-compatible 基础字段之外另有官方扩展字段的形态。仅基址或路径不同、协议相同者不得另立取值。",
      "examples": [
        "anthropic-compatible",
        "openai-compatible"
      ]
    },
    "baseUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://[^/\\s?#]+(?:/[^?\\s#]*[^/?\\s#])?$",
      "description": "来源基址:http 或 https 开头的绝对地址,不得带查询串或片段,末尾不带斜杠;endpoint 的 path 直接拼接在它后面。与插件 base_url 的差别只在末尾斜杠,因为此处 path 以斜杠开头。",
      "examples": [
        "https://api.deepseek.com",
        "https://api.example.com/v1"
      ]
    },
    "endpointPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^/[^\\s?#]*$",
      "description": "站内路径:以斜杠开头,不含协议、主机、查询串与片段;不接受整段绝对地址,也不接受空串。",
      "examples": [
        "/anthropic/v1/messages",
        "/models"
      ]
    },
    "staticHeader": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
          "description": "HTTP 头名,大小写不敏感;此处只允许字母、数字与连字符"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\r\\n]+$",
          "description": "头值,原样写入,不得含换行;不得放密钥"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false,
      "description": "与密钥无关的固定请求头,例如协议版本协商头;仅在声明它的端点发送。"
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/endpointPath"
        },
        "headers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "该端点额外的固定请求头,可选;缺省表示不加任何额外头。",
          "items": {
            "$ref": "#/$defs/staticHeader"
          }
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "description": "单个端点的路径与附加头。"
    },
    "endpoints": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/baseUrl"
        },
        "chat": {
          "$ref": "#/$defs/endpoint",
          "description": "对话补全端点,必填"
        },
        "models": {
          "$ref": "#/$defs/endpoint",
          "description": "模型列表端点,必填;也用于校验密钥可达性"
        },
        "files": {
          "$ref": "#/$defs/endpoint",
          "description": "文件端点,可选;仅当某能力以 file-id 作为输入时才有意义"
        }
      },
      "required": [
        "base",
        "chat",
        "models"
      ],
      "additionalProperties": false,
      "description": "端点集合。base 与各端点 path 的拼接规则见顶层 $comment 第 5 条。"
    },
    "credentialHeader": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$",
          "description": "承载密钥的 HTTP 头名,大小写不敏感"
        },
        "prefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "头值前缀,可选;缺省表示密钥原样作为头值。需要分隔空格时把空格写进前缀,例如 Bearer 加一个空格。不用空串表示缺省。"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "一个承载密钥的请求头。"
    },
    "credential": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "api-key"
          ],
          "description": "凭据类型;当前只有 api-key,新增类型须同步递增 schemaVersion 并补 specs 说明。"
        },
        "headers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "承载密钥的请求头,按顺序全部写入;同一来源接受多种鉴权形态时逐项列出。",
          "items": {
            "$ref": "#/$defs/credentialHeader"
          }
        }
      },
      "required": [
        "kind",
        "headers"
      ],
      "additionalProperties": false,
      "description": "凭据如何随请求发送。本对象只描述位置与格式,不得写入任何密钥、令牌或证书内容。"
    },
    "wireName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]{0,63}$",
      "description": "线上字段名,原样写入请求体;不接受空串与中文。",
      "examples": [
        "max_tokens",
        "stop_sequences"
      ]
    },
    "toolName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{1,63}$",
      "description": "服务端工具名,原样写入请求体。",
      "examples": [
        "deepseek_web_search"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "systemPrompt": {
          "$ref": "#/$defs/wireName",
          "description": "系统提示词字段名,可选"
        },
        "maxTokens": {
          "$ref": "#/$defs/wireName",
          "description": "输出上限字段名,可选"
        },
        "temperature": {
          "$ref": "#/$defs/wireName",
          "description": "温度字段名,可选"
        },
        "topP": {
          "$ref": "#/$defs/wireName",
          "description": "核采样字段名,可选"
        },
        "stop": {
          "$ref": "#/$defs/wireName",
          "description": "停止词字段名,可选"
        }
      },
      "minProperties": 1,
      "additionalProperties": false,
      "description": "逻辑参数名到线上字段名的映射,至少给出一项;未列出的逻辑参数表示该来源不支持。键取自请求补丁的逻辑参数表,不接受自造键名。"
    },
    "capabilityTextGenerate": {
      "type": "object",
      "properties": {
        "id": {
          "const": "text:generate"
        },
        "stream": {
          "type": "string",
          "enum": [
            "sse-anthropic",
            "sse-openai",
            "none"
          ],
          "description": "流式响应的帧方言;须与 format 一致(none 除外),不一致由脚本报错"
        },
        "params": {
          "$ref": "#/$defs/params"
        }
      },
      "required": [
        "id",
        "stream"
      ],
      "additionalProperties": false,
      "description": "文本生成能力。"
    },
    "capabilityReasoningThink": {
      "type": "object",
      "properties": {
        "id": {
          "const": "reasoning:think"
        },
        "field": {
          "$ref": "#/$defs/wireName",
          "description": "开启或关闭思考的字段名"
        },
        "onValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S",
          "description": "开启时该字段的取值,原样写入"
        },
        "offValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S",
          "description": "关闭时该字段的取值,原样写入"
        },
        "budgetField": {
          "$ref": "#/$defs/wireName",
          "description": "思考预算字段名,可选"
        }
      },
      "required": [
        "id",
        "field",
        "onValue",
        "offValue"
      ],
      "additionalProperties": false,
      "description": "推理思考能力。"
    },
    "capabilityVisionImage": {
      "type": "object",
      "properties": {
        "id": {
          "const": "vision:image"
        },
        "input": {
          "type": "string",
          "enum": [
            "file-id",
            "base64",
            "url"
          ],
          "description": "图片的传入方式;file-id 表示先上传再以标识引用,依赖 endpoints.files"
        },
        "mediaTypeField": {
          "$ref": "#/$defs/wireName",
          "description": "媒体类型字段名,可选"
        }
      },
      "required": [
        "id",
        "input"
      ],
      "additionalProperties": false,
      "description": "图片理解能力。"
    },
    "capabilityDocumentRead": {
      "type": "object",
      "properties": {
        "id": {
          "const": "document:read"
        },
        "input": {
          "type": "string",
          "enum": [
            "file-id",
            "base64",
            "url"
          ],
          "description": "文档的传入方式;file-id 依赖 endpoints.files"
        }
      },
      "required": [
        "id",
        "input"
      ],
      "additionalProperties": false,
      "description": "文档阅读能力。"
    },
    "capabilityToolWebSearch": {
      "type": "object",
      "properties": {
        "id": {
          "const": "tool:web-search"
        },
        "kind": {
          "type": "string",
          "enum": [
            "server-tool"
          ],
          "description": "工具由服务端执行;客户端自建工具不写进本能力"
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "服务端工具名,不得为空且不得重复",
          "items": {
            "$ref": "#/$defs/toolName"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "names"
      ],
      "additionalProperties": false,
      "description": "联网搜索能力。"
    },
    "capabilityToolReadUrl": {
      "type": "object",
      "properties": {
        "id": {
          "const": "tool:read-url"
        },
        "kind": {
          "type": "string",
          "enum": [
            "server-tool"
          ]
        },
        "names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "服务端工具名,不得为空且不得重复",
          "items": {
            "$ref": "#/$defs/toolName"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "names"
      ],
      "additionalProperties": false,
      "description": "读取网页能力。"
    },
    "capability": {
      "oneOf": [
        {
          "$ref": "#/$defs/capabilityTextGenerate"
        },
        {
          "$ref": "#/$defs/capabilityReasoningThink"
        },
        {
          "$ref": "#/$defs/capabilityVisionImage"
        },
        {
          "$ref": "#/$defs/capabilityDocumentRead"
        },
        {
          "$ref": "#/$defs/capabilityToolWebSearch"
        },
        {
          "$ref": "#/$defs/capabilityToolReadUrl"
        }
      ],
      "description": "一项能力声明;按 id 判别,各分支字段封闭。新增能力须在此增加分支并把分支名写入 specs。"
    }
  }
}
